# Strict live tests run only against a dedicated disposable workspace.
BL_WORKSPACE=your-dedicated-e2e-workspace
BLAXEL_E2E_WORKSPACE=your-dedicated-e2e-workspace
BLAXEL_E2E_WORKSPACE_ALLOWLIST=your-dedicated-e2e-workspace
# Alternatively: BLAXEL_E2E_WORKSPACE_PREFIX=your-e2e-prefix-
# Use a workspace API key, not a developer token. It remains process-only.
BL_API_KEY=your-dedicated-workspace-api-key
BLAXEL_E2E_ALLOW_DESTRUCTIVE=true

# PM-2611 reviewer lane/full run: explicit acknowledgement that BL_API_KEY is
# an API key. No WorkOS/browser OAuth or MFA is used.
# BLAXEL_E2E_REVIEWER_API_KEY_CONFIRMED=true

# ENG-3887/full run: required so MCP create/get/delete are successful public
# workflows. Use an existing disposable MCP-capable integration (for example GitHub).
# BLAXEL_E2E_MCP_SERVER_INTEGRATION=existing-e2e-integration-connection

# ENG-3888 provider-mutation and real model lifecycle lanes/full run.
# OPENAI_API_KEY must be an approved process-only test credential; the suite
# registers it with the leak scanner before creating the temporary integration.
# BLAXEL_E2E_ALLOW_PROVIDER_MUTATIONS=true
# BLAXEL_E2E_INTEGRATION_TYPE=approved-dummy-secret-integration-type
# OPENAI_API_KEY=approved-process-only-test-key

# User lifecycle/full run. The suite invites and removes the disposable address.
# Use a reserved non-deliverable address. The existing fixture is only updated
# idempotently to the role it already has and is never removed.
# BLAXEL_E2E_ALLOW_USER_MUTATIONS=true
# BLAXEL_E2E_DISPOSABLE_USER_EMAIL=mcp-live-unique@example.invalid
# BLAXEL_E2E_EXISTING_USER_EMAIL=approved-existing-user@example.com
# BLAXEL_E2E_EXISTING_USER_ROLE=admin

# ENG-3423 focused lane: real request-echo agent.
# BLAXEL_E2E_AGENT=mcp-live-request-echo-agent

# Required only by the combined runtime-fixture lane/full acceptance. Both
# fixtures must be disposable mcp-live-* resources; the manifest must set
# delete_after_test=true because the lifecycle deletes and verifies both.
# BLAXEL_E2E_FIXTURE_MANIFEST=e2e/live/testdata/fixtures.json

# Normally generated uniquely by make test-e2e-live. Set only for direct go test.
# BLAXEL_E2E_RUN_PREFIX=mcp-live-20260713130500-12345
